{
	"code": "coin",
	// The old colony coin (before 0.177.0). The colony's money is now rusty gears (or Coinage coins). Kept, hidden,
	// so old saves do not get unknown items: colonies swap these for gears, and a player can swap them in the grid.
	"variantgroups": [ { "code": "metal", "states": ["copper"] } ],
	"maxstacksize": 128,
	"shape": { "base": "createacolony:item/coin" },
	"textures": { "metal": { "base": "game:block/metal/ingot/{metal}" } },
	"guiTransform": { "rotation": { "x": -55, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.03, "z": 0.5 }, "scale": 2.8 },
	"fpHandTransform": { "translation": { "x": 0, "y": 0.2, "z": 0 }, "rotation": { "x": 0, "y": 0, "z": 60 }, "scale": 2 },
	"tpHandTransform": { "translation": { "x": -0.8, "y": -0.1, "z": -0.6 }, "rotation": { "x": 0, "y": 0, "z": -60 }, "scale": 0.8 },
	"groundTransform": { "origin": { "x": 0.5, "y": 0, "z": 0.5 }, "scale": 2.2 }
}
