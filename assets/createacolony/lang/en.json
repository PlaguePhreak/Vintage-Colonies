	"hut-placed-residence": "{0} placed. Settlers sleeping in its beds live here. Right-click it to order level 1, or put beds inside yourself.",
	"tab-residents": "Residents",
	"residence-beds": "Beds: {0}, free: {1}",
	"residence-choose": "Choose residents",
	"residence-choose-hint": "Pick who lives here. A settler's partner and children always move with them. Move out sends them to another Residence with room, or any free bed.",
